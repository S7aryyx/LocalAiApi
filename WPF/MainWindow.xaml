<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ИИ Анализ"
        Width="420"
        Height="650"
        MinHeight="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#17191F"
        Foreground="#F1F1F1"
        Topmost="True">

    <Border BorderBrush="#353943"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#22252D"
                    CornerRadius="9,9,0,0">

                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="AI Analysis"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="14,0,50,0"/>

                    <Button x:Name="ToggleButton"
                            Content="›"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            Margin="0,0,6,0"
                            FontSize="22"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ToggleButton_Click"/>
                </Grid>
            </Border>
            
            <Grid x:Name="ContentPanel"
                  Grid.Row="1"
                  Margin="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="ResponseTextBox"
                         Grid.Row="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="12"
                         Background="#20232B"
                         Foreground="#E8EAF0"
                         BorderBrush="#353943"
                         FontSize="14"/>

                <Button x:Name="GenerateButton"
                        Grid.Row="1"
                        Content="Сгенерировать анализ"
                        Height="44"
                        Margin="0,12,0,0"
                        Background="Purple"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="GenerateButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
